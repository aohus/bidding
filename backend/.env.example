# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bidding_db
# SQLAlchemy echo. true 면 모든 SQL 과 바인드 파라미터(JSONB 전문 포함)가 로그로 나간다.
# 운영에서는 반드시 false.
SQL_ECHO=false

# API Keys
# 반드시 공공데이터포털의 "디코딩" 키를 넣을 것.
# "인코딩" 키(%2F, %2B, %3D 포함)를 넣으면 클라이언트가 재인코딩해서
# HTTP 403 / returnReasonCode 30 (등록되지 않은 서비스키) 가 된다.
# 일일 한도 초과(HTTP 429 또는 resultCode 22) 시 V2 → V3 → V4 로 자동 로테이션.
# 마지막 로테이션 후 24h 경과하면 V1 부터 다시 시도.
NARAJANGTER_SERVICE_KEY=your_service_key_here
NARAJANGTER_SERVICE_KEY_V2=
NARAJANGTER_SERVICE_KEY_V3=
NARAJANGTER_SERVICE_KEY_V4=

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Email Configuration (SMTP)
# For Gmail: Use App Password (https://support.google.com/accounts/answer/185833)
# For SendGrid: Use API key as password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-or-api-key
FROM_EMAIL=your-email@gmail.com
FROM_NAME=입찰 정보 시스템

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=true
NOTIFICATION_CHECK_INTERVAL=3600