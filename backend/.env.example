# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bidding_db
# SQLAlchemy echo. true 면 모든 SQL 과 바인드 파라미터(JSONB 전문 포함)가 로그로 나간다.
# 운영에서는 반드시 false.
SQL_ECHO=false

# API Keys
# 반드시 공공데이터포털의 "디코딩" 키를 넣을 것.
# "인코딩" 키(%2F, %2B, %3D 포함)를 넣으면 클라이언트가 재인코딩해서
# HTTP 403 / returnReasonCode 30 (등록되지 않은 서비스키) 가 된다.
# 일일 한도 초과(HTTP 429 또는 resultCode 22) 시 V2 → V3 → V4 → LOCAL 로 자동 로테이션.
# 마지막 로테이션 후 24h 경과하면 V1 부터 다시 시도.
# 인코딩 키를 넣어도 로드 시 자동 디코딩되지만, 디코딩 키를 넣는 것이 원칙.
NARAJANGTER_SERVICE_KEY=your_service_key_here
NARAJANGTER_SERVICE_KEY_V2=
NARAJANGTER_SERVICE_KEY_V3=
NARAJANGTER_SERVICE_KEY_V4=
# 최후 폴백 키. 나라장터 서비스에는 쓸 수 있으나, 외부기관(LH/수자원/지역난방/
# 마사회/가스공사) 서비스에 활용신청이 안 된 키라면 그쪽에서는 403 이 난다
# (403 도 로테이션 트리거라 안전하게 다음 키로 넘어감).
LOCAL_NARAJANGTER_SERVICE_KEY=

# 전력개발포털(bigdata.kepco.co.kr) 전용 키 — data.go.kr 이 아닌 별도 포털이고
# 파라미터명도 serviceKey 가 아니라 apiKey 다. 한전 + 발전 계열사 14곳을 커버하며
# 한국서부발전(COM02)/한국중부발전(COM05)도 여기에 포함된다.
ELECTRIC_INST_SERVICE_KEY=

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Email Configuration (SMTP)
# For Gmail: Use App Password (https://support.google.com/accounts/answer/185833)
# For SendGrid: Use API key as password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-or-api-key
FROM_EMAIL=your-email@gmail.com
FROM_NAME=입찰 정보 시스템

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=true
NOTIFICATION_CHECK_INTERVAL=3600

# 외부기관(비-나라장터) 공고 수집 스케줄러.
# 기본 false — DB 마이그레이션 적용 후 명시적으로 켠다.
ENABLE_EXTERNAL_BID_SYNC=false